{
  "name": "roma-fast-food-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend distribuido de Roma Fast Food con NestJS, CQRS, PostgreSQL y RabbitMQ.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "build:all": "npm run build -- auth-service && npm run build -- operations-service && npm run build -- inventory-service && npm run build -- reporting-service",
    "start:auth": "nest start auth-service",
    "start:operations": "nest start operations-service",
    "start:inventory": "nest start inventory-service",
    "start:reporting": "nest start reporting-service",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:operations": "nest start operations-service --watch",
    "start:dev:inventory": "nest start inventory-service --watch",
    "start:dev:reporting": "nest start reporting-service --watch",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "eslint \"{apps,libs,scripts}/**/*.ts\" --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:keys": "node -r ts-node/register -r tsconfig-paths/register scripts/generate-jwt-keys.ts",
    "db:migrate:auth": "node -r ts-node/register -r tsconfig-paths/register scripts/run-auth-migrations.ts",
    "db:seed:auth": "node -r ts-node/register -r tsconfig-paths/register scripts/seed-auth.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.1.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "@nestjs/jwt": "^11.0.2",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
