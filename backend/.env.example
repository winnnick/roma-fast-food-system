# Configuración local de referencia. No guardar secretos reales en Git.
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# PostgreSQL. En desarrollo local cada microservicio conserva su propia base.
AUTH_DATABASE_URL=postgresql://roma:roma_dev_password@localhost:55432/roma_auth
OPERATIONS_DATABASE_URL=postgresql://roma:roma_dev_password@localhost:55432/roma_operations
INVENTORY_DATABASE_URL=postgresql://roma:roma_dev_password@localhost:55432/roma_inventory
REPORTING_DATABASE_URL=postgresql://roma:roma_dev_password@localhost:55432/roma_reporting
DATABASE_SSL=false

# RabbitMQ
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://roma:roma_dev_password@localhost:5672
RABBITMQ_QUEUE=roma.auth

# JWT de acceso. Auth firma con la clave privada; los demás servicios
# solo necesitarán la clave pública para validar el mismo token.
JWT_PRIVATE_KEY_PATH=.secrets/dev/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.secrets/dev/jwt-public.pem
JWT_ISSUER=roma-fast-food-auth
JWT_AUDIENCE=roma-fast-food-api
JWT_ACCESS_TTL_SECONDS=900

# Refresh token opaco. Se guarda únicamente su hash SHA-256 en PostgreSQL.
REFRESH_TOKEN_TTL_SECONDS=43200
REFRESH_COOKIE_NAME=roma_refresh_token
REFRESH_COOKIE_SECURE=false

# Usuarios iniciales de demostración. Para producción deben cambiarse.
SEED_ADMIN_PASSWORD=Roma2026*
SEED_CAJERO_PASSWORD=Caja2026*
SEED_INVENTARIO_PASSWORD=Stock2026*
SEED_INACTIVO_PASSWORD=Usuario2026*

# URLs locales para smoke tests HTTP
AUTH_BASE_URL=http://localhost:3101/api/v1
OPERATIONS_BASE_URL=http://localhost:3102/api/v1

# Comunicación interna entre microservicios. Cambiar en producción.
INTERNAL_SERVICE_TOKEN=roma_internal_dev_change_me
INTERNAL_HTTP_TIMEOUT_MS=5000
INVENTORY_INTERNAL_BASE_URL=http://localhost:3103/api/v1/internal/inventario

REPORTING_BASE_URL=http://localhost:3104/api/v1

# Snapshots internos para reconstrucción del modelo de lectura de Reporting
AUTH_INTERNAL_REPORTING_URL=http://localhost:3101/api/v1/internal/reporting/snapshot
OPERATIONS_INTERNAL_REPORTING_URL=http://localhost:3102/api/v1/internal/reporting/snapshot
INVENTORY_INTERNAL_REPORTING_URL=http://localhost:3103/api/v1/internal/reporting/snapshot
